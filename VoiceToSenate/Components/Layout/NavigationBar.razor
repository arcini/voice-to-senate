<div class="border border-light-subtle">
    <SfAppBar CssClass="shadow-sm taller-appbar py-1">
        <div class="px-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <img class="me-2" src="Assets/Images/voicetosenate.jpg" alt="company logo" height="64px" />
            </div>
            <div class="d-flex align-self-end py-2 mx-1 justify-content-between">
                <!-- instagram icon -->
                <a href="https://www.instagram.com/voicetosenate/" class="text-decoration-none text-reset px-1">
                    <i class="fa-brands fa-instagram fs-5"></i>
                </a>
                <!-- X/twitter icon -->
                <a href="https://x.com/voicetosenate" class="text-decoration-none text-reset px-1">
                    <i class="fa-brands fa-x-twitter fs-5"></i>
                </a>
                <!-- tiktok icon -->
                <a href="https://www.tiktok.com/@@voicesenate" class="text-decoration-none text-reset px-1">
                    <i class="fa-brands fa-tiktok fs-5"></i>
                </a>
            </div>
            <div class="e-appbar-spacer"></div>
            <div class="d-flex w-50">
                <SfButton CssClass="flex-grow-1 me-4 d-none d-sm-block e-secondary" IconCss="fa-solid fa-message" IconPosition="IconPosition.Left" Content="Templates" Type="button" aria-label="templates" role="button"></SfButton>
                <SfButton CssClass="flex-grow-1 me-4 d-none d-sm-block e-secondary" IconCss="fa-solid fa-landmark" IconPosition="IconPosition.Left" Content="Senators" Type="button" aria-label="senators" role="button"></SfButton>
                <SfButton CssClass="flex-grow-1 me-4 d-none d-sm-block e-secondary" IconCss="fa-solid fa-circle-question" IconPosition="IconPosition.Left" Content="About" Type="button" aria-label="about" role="button"></SfButton>
                <SfButton CssClass="flex-grow-1 me-4 d-none d-sm-block e-secondary" IconCss="fa-solid fa-envelope" IconPosition="IconPosition.Left" Content="Contact Us" Type="button" aria-label="contact us" role="button"></SfButton>
                <SfButton CssClass="flex-grow-1 me-4 d-none d-sm-block e-secondary" IconCss="fa-solid fa-money-bill" IconPosition="IconPosition.Left" Content="Donate" Type="button" aria-label="donate" role="button"></SfButton>
            </div>
        </div>
    </SfAppBar>
</div>

